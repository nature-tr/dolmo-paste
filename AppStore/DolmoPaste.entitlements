<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Mac App Store 必须开沙盒；资源都落在容器里，代码不用改路径 -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- 这两项 Xcode 打包时会自动注入，我们手工 codesign 就得自己写。
         缺了上传会报 90886：签名里没有 application-identifier，
         但描述文件里有 → 构建收下但不能用 TestFlight -->
    <key>com.apple.application-identifier</key>
    <string>7ZYS44VSC3.top.dolmo.paste.app</string>
    <key>com.apple.developer.team-identifier</key>
    <string>7ZYS44VSC3</string>

    <!-- 片段导入：NSOpenPanel 选中的文件要能读 -->
    <key>com.apple.security.files.user-selected.read-only</key>
    <true/>

    <!-- 片段导出：NSSavePanel 给回来的 URL 在沙盒下必须靠这项才能写。
         之前只开了 read-only，结果上架版点「导出」写不进去，而调用处是 try?，
         失败完全静默——用户以为导出了，其实什么都没发生 -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- 不要加 com.apple.security.automation.apple-events。
         它只服务于「模拟 ⌘V / 控制别的 App」，而 App Store 按 2.4.5 明确
         不允许把这类能力用于粘贴。现在应用不发送任何 Apple 事件。 -->

    <!-- ⚠️ 别加任何 value=false 的 entitlement。
         这里曾经有一行 com.apple.security.device.audio-input = false（复制粘贴残留），
         结果第一次提审就被打回：Guideline 2.4.5(i)
         「Entitlement "com.apple.security.device.audio-input" value must not be false」。
         苹果的规则是：不需要的权限就整条删掉，不能写成 false。
         Vision OCR、剪贴板、SwiftData 都不需要额外 entitlement。 -->
</dict>
</plist>

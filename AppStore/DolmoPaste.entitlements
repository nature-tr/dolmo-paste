<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Mac App Store 必须开沙盒；资源都落在容器里，代码不用改路径 -->
    <key>com.apple.security.app-sandbox</key>
    <true/>

    <!-- 片段导入：NSOpenPanel 选中的文件要能读 -->
    <key>com.apple.security.files.user-selected.read-only</key>
    <true/>

    <!-- 片段导出：NSSavePanel 给回来的 URL 在沙盒下必须靠这项才能写。
         之前只开了 read-only，结果上架版点「导出」写不进去，而调用处是 try?，
         失败完全静默——用户以为导出了，其实什么都没发生 -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>

    <!-- 模拟 ⌘V 需要辅助功能权限。注意：MAS 审核对这项一向严格，
         2.4.5 / 5.1.1 条款下有被拒风险，审核备注里已如实说明用途 -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>

    <!-- Vision OCR 在本机跑，不联网；仍声明只读用户选择项以避免权限弹窗歧义 -->
    <key>com.apple.security.device.audio-input</key>
    <false/>
</dict>
</plist>

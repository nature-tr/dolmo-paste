<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleName</key>
    <string>dolmo paste</string>
    <key>CFBundleDisplayName</key>
    <string>dolmo paste</string>
    <key>CFBundleIdentifier</key>
    <string>top.dolmo.paste.app</string>
    <key>CFBundleExecutable</key>
    <string>DolmoPaste</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleIconFile</key>
    <string>AppIcon</string>
    <!-- macOS 11+ 要求显式声明，codesign 会据此校验 Info.plist -->
    <key>PRODUCT_BUNDLE_IDENTIFIER</key>
    <string>top.dolmo.paste.app</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0.0</string>
    <!-- build 2 = 被 2.4.5 拒掉的旧逻辑（含辅助功能模拟 ⌘V），不能再复用 -->
    <key>CFBundleVersion</key>
    <string>3</string>
    <key>CFBundleDevelopmentRegion</key>
    <string>zh_CN</string>
    <key>CFBundleLocalizations</key>
    <array>
        <string>zh_CN</string>
    </array>
    <key>LSUIElement</key>
    <true/>
    <key>LSMinimumSystemVersion</key>
    <string>14.0</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <!-- 上架必需：App Store 会按 UTI 给应用分类，缺失直接报 90242 拒收。
         productivity = 生产率，Utilities（工具）是另一个常见选择 -->
    <key>LSApplicationCategoryType</key>
    <string>public.app-category.productivity</string>
    <key>NSPrincipalClass</key>
    <string>NSApplication</string>
    <key>NSSupportsAutomaticTermination</key>
    <false/>

    <!-- 出口合规：声明「不使用非豁免加密」，App Store Connect 会自动置
         usesNonExemptEncryption = false，不必每次上传后去网页答一遍加密问题。
         本 App 无网络请求、无自研/第三方加密，只用到系统提供的标准能力。
         注意：这个 key 只对「打包时带上它」的构建生效，历史上的 build 1/2 没带 -->
    <key>ITSAppUsesNonExemptEncryption</key>
    <false/>

    <!-- 不要再加 NSAccessibilityUsageDescription / NSAppleEventsUsageDescription。
         1.0 因为「用辅助功能模拟 ⌘V」被按 Guideline 2.4.5 拒绝，
         现在应用完全不碰辅助功能：选中条目只写剪贴板，粘贴由用户按 ⌘V。 -->
</dict>
</plist>
